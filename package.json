{
  "name": "nucleus-hrms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "npx --yes drizzle-kit@latest generate --dialect=postgresql --schema=./src/lib/db/schema.ts --out=./db/migrations",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:status": "tsx scripts/db-status.ts",
    "auth:reset-password": "tsx scripts/reset-password.ts",
    "auth:provision-user": "tsx scripts/provision-user.ts",
    "seed:demo-tenants": "tsx scripts/seed-demo-tenants.ts",
    "db:schema:generate": "tsx scripts/generate-canonical-schema.ts",
    "db:verify": "tsx scripts/verify-canonical-schema.ts",
    "data:manifest": "node scripts/generate-workspace-manifest.mjs",
    "test": "vitest run",
    "test:ui": "node --import ./scripts/test-data-setup.mjs --test tests/*.test.cjs tests/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:ui && npm run build",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "env:check": "tsx scripts/check-env.ts",
    "prebuild": "npm run env:check",
    "release:check": "tsx scripts/check-env.ts --production",
    "db:local:create": "node scripts/database/create-local.mjs",
    "db:verify:enterprise": "tsx scripts/database/verify-live.mts",
    "db:verify:fresh": "tsx scripts/database/verify-fresh.mts",
    "enterprise:discover": "node scripts/discover-enterprise.mjs && node scripts/discover-ui-text.mjs && node scripts/database/catalog-localization.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/drizzle-adapter": "^1.7.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@langchain/core": "^1.2.10",
    "@langchain/langgraph": "^1.4.14",
    "@langchain/openai": "^1.5.12",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@neondatabase/serverless": "^1.1.0",
    "baseline-browser-mapping": "^2.11.23",
    "better-auth": "^1.7.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "echarts": "^6.1.0",
    "framer-motion": "^12.29.2",
    "langchain": "^1.5.11",
    "lucide-react": "^0.563.0",
    "next": "^16.3.5",
    "pg": "^8.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.13",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.12.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": "22.x"
  }
}
