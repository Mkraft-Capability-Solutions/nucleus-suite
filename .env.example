# Workspace data provider. Options: json | database
APP_DATA_MODE=database

# Disabled by default in production. Enable for a synthetic-data preview.
DEMO_AUTH_ENABLED=true
ALLOW_INITIAL_ADMIN_SIGNUP=true

# Local origin. On Vercel, set it for Production; previews fall back to the deployment URL.
BETTER_AUTH_URL=http://localhost:3000
# Generate independently for each environment: openssl rand -base64 32
BETTER_AUTH_SECRET=
AUTH_COOKIE_MAX_AGE=604800
AUTH_COOKIE_SAME_SITE=lax
ADDITIONAL_TRUSTED_ORIGINS=

# PostgreSQL. The application connects as a login role that is a member of app_runtime (subject
# to row-level security); migrations connect as the owner role. See db/MIGRATIONS.md.
# On Neon use the pooled ("-pooler") host for DATABASE_URL.
DATABASE_URL=postgresql://nucleus_app:your_password@localhost:5432/nucleus_hrms
# Admin tooling only: direct, non-pooled endpoint, owner role.
# Migration transport: neon (HTTP) or postgres (TCP)
MIGRATION_DATABASE_DRIVER=postgres
MIGRATION_DATABASE_URL=postgresql://owner:your_password@localhost:5432/nucleus_hrms

# Platform operators (comma-separated emails): /platform console, organisations and their modules.
PLATFORM_ADMIN_EMAILS=

# Vercel Cron authenticates to /api/cron/tick with this bearer secret (openssl rand -hex 32).
CRON_SECRET=

# Optional AI services
OPENAI_API_KEY=
OPENAI_MODEL=
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# Browser tests only: supply via ignored .env.local or a CI secret; never NEXT_PUBLIC_.
# DEMO_TEST_PASSWORD=Yourp@$$w0rd

# Nucleus Talk — Gemini Live API for Voice AI
GEMINI_API_KEY=
GEMINI_PROJECT_ID=

# Document vault — HMAC secret for 5-minute signed document links (at least 32 characters)
DOCUMENT_URL_SIGNING_SECRET=

# Field-level encryption for sensitive employee data (visa numbers etc.): 64 hex chars (openssl rand -hex 32).
HRMS_FIELD_ENCRYPTION_KEY=
