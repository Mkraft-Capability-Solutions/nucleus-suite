# Workspace data provider. Only json is implemented; database is not a valid mode yet.
APP_DATA_MODE=json
# Disabled by default. Enable ONLY for a synthetic-data preview.
# This UI is not ready for customer production; run npm run release:check.
DEMO_AUTH_ENABLED=false
ALLOW_INITIAL_ADMIN_SIGNUP=false

# Local origin. Vercel/Netlify: supply the exact HTTPS site origin in hosted environments.
BETTER_AUTH_URL=http://localhost:3000
# Generate independently for each environment: openssl rand -base64 32
BETTER_AUTH_SECRET=
AUTH_COOKIE_MAX_AGE=604800
AUTH_COOKIE_SAME_SITE=lax
ADDITIONAL_TRUSTED_ORIGINS=

# Optional backend integration. JSON mode does not require a database.
DATABASE_URL=
# Admin tooling only: direct, non-pooled PostgreSQL endpoint. Keep off UI preview deployments.
MIGRATION_DATABASE_URL=
PLATFORM_ADMIN_EMAILS=

# Blank model uses the code default; AI is optional.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# NODE_ENV is set by Next.js. PORT/HOST are CLI settings, not hosted environment settings.
# LOG_LEVEL, DATABASE_POOL_MAX and DATABASE_TIMEOUT are not consumed by this app.

# Browser tests only: supply via ignored .env.local or a CI secret; never NEXT_PUBLIC_.
# DEMO_TEST_PASSWORD=
