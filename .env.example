# Workspace data provider. Options: json | database
APP_DATA_MODE=database

# Disabled by default in production. Enable for a synthetic-data preview.
DEMO_AUTH_ENABLED=true
ALLOW_INITIAL_ADMIN_SIGNUP=true

# Local origin. Vercel/Netlify: supply the exact HTTPS site origin in hosted environments.
BETTER_AUTH_URL=http://localhost:3000
# Generate independently for each environment: openssl rand -base64 32
BETTER_AUTH_SECRET=
AUTH_COOKIE_MAX_AGE=604800
AUTH_COOKIE_SAME_SITE=lax
ADDITIONAL_TRUSTED_ORIGINS=

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://root:your_password@localhost:5432/nucleus_hrms
# Admin tooling only: direct, non-pooled PostgreSQL endpoint.
# Migration transport: neon (HTTP) or postgres (TCP)
MIGRATION_DATABASE_DRIVER=postgres
MIGRATION_DATABASE_URL=postgresql://root:your_password@localhost:5432/nucleus_hrms
PLATFORM_ADMIN_EMAILS=

# Optional AI services
OPENAI_API_KEY=
OPENAI_MODEL=
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# Browser tests only: supply via ignored .env.local or a CI secret; never NEXT_PUBLIC_.
# DEMO_TEST_PASSWORD=Yourp@$$w0rd

# Nucleus Talk — Gemini Live API for Voice AI
GEMINI_API_KEY=XX.Xx1XX2X*****************************************X34XXxXX
GEMINI_PROJECT_ID=8XXXXXXXXXX5
