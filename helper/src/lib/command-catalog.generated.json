  {
    "id": "POST /api/v1/commands/evaluate_attendance",
    "module": "attendance",
    "section": "commands/evaluate_attendance",
    "path": "/api/v1/commands/evaluate_attendance",
    "method": "POST",
    "label": "evaluate attendance",
    "body": {
      "kind": "object",
      "fields": [
        {
          "name": "attendanceDayId",
          "kind": "text",
          "format": "uuid"
        },
        {
          "name": "employeeId",
          "kind": "text",
          "format": "uuid"
        },
        {
          "name": "attendanceDate",
          "kind": "text",
          "format": "date"
        },
        {
          "name": "ruleSetId",
          "kind": "text",
          "format": "uuid"
        },
        {
          "name": "assignedShift",
          "kind": "text",
          "min": 1,
          "max": 20
        },
        {
          "name": "shiftHours",
          "kind": "select",
          "options": [
            8,
            9,
            10,
            12
          ]
        },
        {
          "name": "windows",
          "kind": "array",
          "item": {
            "kind": "object",
            "fields": [
              {
                "name": "code",
                "kind": "text"
              },
              {
                "name": "earliestMinute",
                "kind": "number",
                "integer": true,
                "min": 0,
                "max": 1439
              },
              {
                "name": "latestMinute",
                "kind": "number",
                "integer": true,
                "min": 0,
                "max": 1439
              },
              {
                "name": "durationMinutes",
                "kind": "number",
                "integer": true,
                "min": 1
              }
            ]
          },
          "optional": true
        },
        {
          "name": "punches",
          "kind": "array",
          "item": {
            "kind": "object",
            "fields": [
              {
                "name": "type",
                "kind": "select",
                "options": [
                  "in",
                  "out"
                ]
              },
              {
                "name": "at",
                "kind": "text"
              }
            ]
          },
          "min": 2
        },
        {
          "name": "firstPunchIso",
          "kind": "text",
          "format": "datetime"
        },
        {
          "name": "gatePassMinutes",
          "kind": "number",
          "integer": true,
          "min": 0,
          "default": 0,
          "optional": true
        },
        {
          "name": "otPolicy",
          "kind": "select",
          "options": [
            "all-days",
            "rest-holiday-only",
            "not-eligible"
          ]
        },
        {
          "name": "dayType",
          "kind": "select",
          "options": [
            "working",
            "weekly_off",
            "holiday",
            "festival"
          ]
        },
        {
          "name": "minutesLate",
          "kind": "number",
          "integer": true,
          "min": 0,
          "default": 0,
          "optional": true
        },
        {
          "name": "lateOccurrencesThisMonth",
          "kind": "number",
          "integer": true,
          "min": 0,
          "default": 0,
          "optional": true
        },
        {
          "name": "assistantManagerOrAbove",
          "kind": "boolean",
          "default": false,
          "optional": true
        },
        {
          "name": "workedPast3AmPreviousDay",
          "kind": "boolean",
          "default": false,
          "optional": true
        },
        {
          "name": "timeZone",
          "kind": "text",
          "default": "Asia/Kolkata",
          "optional": true
        }
      ]
    },
    "permissions": [
      "attendance.evaluate"
    ],
    "query": [],
    "version": false,
    "source": "src/app/api/v1/commands/[action]/route.ts"
  },
