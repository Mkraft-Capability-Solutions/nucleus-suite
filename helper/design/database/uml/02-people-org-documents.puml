@startuml
title MKraft HRMS - People, organization & documents\nPROPOSED: 37 owned tables / 117 outgoing FK constraints
!include includes/style.iuml
package "People, organization & documents" {
!include includes/02-people-org-documents-tables.iuml
}
package "External reference keys" {
entity "jurisdictions" as jurisdictions <<external>> {
  * id : uuid <<PK>>
  * tenant_id : uuid
  * code : text
  --
  UK (tenant_id, id)
  UK (tenant_id, code)
}

entity "legal_entities" as legal_entities <<external>> {
  * id : uuid <<PK>>
  * tenant_id : uuid
  * code : text
  --
  UK (tenant_id, id)
  UK (tenant_id, code)
}

entity "roles" as roles <<external>> {
  * id : uuid <<PK>>
  * tenant_id : uuid
  * code : text
  --
  UK (tenant_id, id)
  UK (tenant_id, code)
}

entity "tenants" as tenants <<external>> {
  * id : uuid <<PK>>
  * code : text
  --
  UK (code)
}

entity "users" as users <<external>> {
  * id : uuid <<PK>>
  * tenant_id : uuid
  * email : text
  --
  UK (tenant_id, id)
  UK (tenant_id, email)
}
}
!include includes/02-people-org-documents-relations.iuml
!include includes/legend.iuml
@enduml
