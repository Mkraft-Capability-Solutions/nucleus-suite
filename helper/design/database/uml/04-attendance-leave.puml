@startuml
title MKraft HRMS - Attendance, shifts, leave, OT & gate pass\nPROPOSED: 29 owned tables / 96 outgoing FK constraints
!include includes/style.iuml
package "Attendance, shifts, leave, OT & gate pass" {
!include includes/04-attendance-leave-tables.iuml
}
package "External reference keys" {
entity "approval_requests" as approval_requests <<external>> {
  * id : uuid <<PK>>
  * tenant_id : uuid
  --
  UK (tenant_id, id)
}

entity "employees" as employees <<external>> {
  * id : uuid <<PK>>
  * tenant_id : uuid
  * employee_number : text
  --
  UK (tenant_id, id)
  UK (tenant_id, employee_number)
}

entity "jurisdictions" as jurisdictions <<external>> {
  * id : uuid <<PK>>
  * tenant_id : uuid
  * code : text
  --
  UK (tenant_id, id)
  UK (tenant_id, code)
}

entity "legal_entities" as legal_entities <<external>> {
  * id : uuid <<PK>>
  * tenant_id : uuid
  * code : text
  --
  UK (tenant_id, id)
  UK (tenant_id, code)
}

entity "locations" as locations <<external>> {
  * id : uuid <<PK>>
  * tenant_id : uuid
  * code : text
  --
  UK (tenant_id, id)
  UK (tenant_id, code)
}

entity "organization_units" as organization_units <<external>> {
  * id : uuid <<PK>>
  * tenant_id : uuid
  * code : text
  --
  UK (tenant_id, id)
  UK (tenant_id, code)
}

entity "tenants" as tenants <<external>> {
  * id : uuid <<PK>>
  * code : text
  --
  UK (code)
}

entity "users" as users <<external>> {
  * id : uuid <<PK>>
  * tenant_id : uuid
  * email : text
  --
  UK (tenant_id, id)
  UK (tenant_id, email)
}

entity "work_items" as work_items <<external>> {
  * id : uuid <<PK>>
  * tenant_id : uuid
  --
  UK (tenant_id, id)
}
}
!include includes/04-attendance-leave-relations.iuml
!include includes/legend.iuml
@enduml
