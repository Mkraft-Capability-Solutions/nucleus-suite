@startuml
title MKraft HRMS - Workflow, approvals, inbox & notifications\nPROPOSED: 13 owned tables / 43 outgoing FK constraints
!include includes/style.iuml
package "Workflow, approvals, inbox & notifications" {
!include includes/03-workflow-notifications-tables.iuml
}
package "External reference keys" {
entity "delegations" as delegations <<external>> {
  * id : uuid <<PK>>
  * tenant_id : uuid
  --
  UK (tenant_id, id)
}

entity "legal_entities" as legal_entities <<external>> {
  * id : uuid <<PK>>
  * tenant_id : uuid
  * code : text
  --
  UK (tenant_id, id)
  UK (tenant_id, code)
}

entity "roles" as roles <<external>> {
  * id : uuid <<PK>>
  * tenant_id : uuid
  * code : text
  --
  UK (tenant_id, id)
  UK (tenant_id, code)
}

entity "tenants" as tenants <<external>> {
  * id : uuid <<PK>>
  * code : text
  --
  UK (code)
}

entity "users" as users <<external>> {
  * id : uuid <<PK>>
  * tenant_id : uuid
  * email : text
  --
  UK (tenant_id, id)
  UK (tenant_id, email)
}
}
!include includes/03-workflow-notifications-relations.iuml
!include includes/legend.iuml
@enduml
