{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "regions": [
    "bom1"
  ],
  "env": {
    "APP_DATA_MODE": "database"
  },
  "build": {
    "env": {
      "APP_DATA_MODE": "database"
    }
  },
  "functions": {
    "src/app/api/**/*": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/tick",
      "schedule": "0 0 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
